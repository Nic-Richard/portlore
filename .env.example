PORT=3002

# Server-side service credentials
GEMINI_API_KEY=
PEXELS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Guides are curated with Gemini; set to anthropic (with ANTHROPIC_API_KEY) to use Claude
CITY_MODEL_PROVIDER=gemini
ANTHROPIC_API_KEY=

# Public generation safeguards
GENERATION_IP_LIMIT=3
GENERATION_COOLDOWN_SECONDS=60
GENERATION_DAILY_LIMIT=20
